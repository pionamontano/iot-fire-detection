 value="220 Ω" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff;strokeColor=#000;" vertex="1" parent="1"><mxGeometry x="1090" y="480" width="70" height="20" as="geometry"/></mxCell><mxCell id="c122" value="Blue LED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#0066cc;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="476" width="110" height="28" as="geometry"/></mxCell><mxCell id="e123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#0066cc;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e124" value="A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#0066cc;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c121" target="c122"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c125" value="GND" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400" y="481" width="52" height="18" as="geometry"/></mxCell><mxCell id="e126" value="K" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#333333;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c122" target="c125"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c127" value="Piezo buzzer" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1240" y="560" width="150" height="78" as="geometry"/></mxCell><mxCell id="c128" value="+" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=3;" vertex="1" parent="1"><mxGeometry x="1238" y="590" width="64" height="18" as="geometry"/></mxCell><mxCell id="c129" value="−" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=3;" vertex="1" parent="1"><mxGeometry x="1238" y="612" width="64" height="18" as="geometry"/></mxCell><mxCell id="e130" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#33aa33;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c128"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c131" value="GND" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1160" y="612" width="52" height="18" as="geometry"/></mxCell><mxCell id="e132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#333333;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c129" target="c131"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c133" value="&lt;b&gt;Changes vs. original drawing (per firmware config.example.h / FIRMWARE_GUIDE.md)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ESP32 5V now fed from the LM2596 buck (+5V rail)&lt;/b&gt;, not PACK+ (2S pack is 6–8.4 V).&lt;br&gt;• &lt;b&gt;GPS UART fixed&lt;/b&gt;: GPS TX → GPIO16 (GPS_RX_PIN), GPS RX → GPIO17 (GPS_TX_PIN); GPS VCC → 3V3 (was unconnected).&lt;br&gt;• &lt;b&gt;DS18B20&lt;/b&gt;: DAT goes straight to GPIO4; the 4.7 kΩ is a pull-up DAT→3V3 (was in series).&lt;br&gt;• &lt;b&gt;MQ-7 heater driver added&lt;/b&gt; on GPIO25 (LEDC PWM, 100% = 5 V heat, 28% ≈ 1.4 V measure). Sensor Vc comes from the driver output, not the 5V rail. AO is ≤ Vc (1.4 V) so GPIO34 is safe without a divider. DO unused.&lt;br&gt;• &lt;b&gt;Battery/mains sense added&lt;/b&gt;: R1=R2=10 kΩ divider → GPIO35 (ratio 2.0, ADC1). Firmware code does not say which rail is sensed; drawn on DC_IN+ (adapter output) — confirm. GPIO35 max 3.3 V ⇒ sensed rail must be ≤ 6.6 V.&lt;br&gt;• &lt;b&gt;SIM800L&lt;/b&gt;: GSM_RX_PIN=26 ← SIM TXD, GSM_TX_PIN=27 → SIM RXD (matches). Firmware guide calls for a dedicated ~4.0 V rail with ≥1000 µF cap (2 A TX bursts); 1000 µF cap added. Verify whether your EVB takes 5V or 4V on its input.&lt;br&gt;• LEDs (Yellow 14, Red 12, Blue 13) and buzzer (32) match firmware; buzzer is an active module, HIGH = on. If it is a bare buzzer, drive it via a transistor.&lt;br&gt;• All GND hexagons are one common ground net; same-named hexagons (+5V, +3V3, MQ7_VC, DC_IN+) are the same net.&lt;br&gt;• Source link (Cirkit Designer) and the SVG could not be opened from this environment; based on the original .drawio + firmware." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-60" y="780" width="900" height="260" as="geometry"/></mxCell><mxCell id="c134" value="IoT Fire Detection Node — Schematic (corrected to match firmware)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="-60" y="-20" width="700" height="40" as="geometry"/></mxCell><mxCell id="h_gps3v3" value="+3V3" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="64" height="18" as="geometry"/></mxCell><mxCell id="e_gps3v3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#66cc99;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c23" target="h_gps3v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h_esp3v3" value="+3V3" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1000" y="210" width="64" height="18" as="geometry"/></mxCell><mxCell id="e_esp3v3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#66cc99;fontSize=9;" edge="1" parent="1" source="c8" target="h_esp3v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h_buck5v" value="+5V" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="262" y="300" width="64" height="18" as="geometry"/></mxCell><mxCell id="e_buck5v" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#d79b00;fontSize=9;" edge="1" parent="1" source="c41" target="h_buck5v"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h_simp" value="+5V" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="64" height="18" as="geometry"/></mxCell><mxCell id="c_simcap" value="1000 µF cap" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff;strokeColor=#000;" vertex="1" parent="1"><mxGeometry x="420" y="439" width="80" height="20" as="geometry"/></mxCell><mxCell id="h_simg" value="GND" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.2;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="440" width="64" height="18" as="geometry"/></mxCell><mxCell id="e_cap1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#d79b00;fontSize=9;" edge="1" parent="1" source="h_simp"