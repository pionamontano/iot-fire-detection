# Copy to .env and fill in your Supabase project's values (see docs/MIGRATION_GUIDE.md, Step 4).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
# Optional: the app fetches the Web Push public key from the server (VAPID_PUBLIC_KEY Edge Function secret);
# this is only used if the server can't be reached. If set, it must match that secret.
VITE_VAPID_PUBLIC_KEY=
