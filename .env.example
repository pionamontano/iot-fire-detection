# Copy to .env and fill in your Supabase project's values (see docs/MIGRATION_GUIDE.md, Step 4).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
# Optional: Web Push public key, matching the VAPID_PUBLIC_KEY Edge Function secret.
VITE_VAPID_PUBLIC_KEY=
